@using MudBlazor


<MudNavMenu>
    @if (menuItems == null)
    {
        <MudText Typo="Typo.body2">Yükleniyor...</MudText>
    }
    else
    {
       @*  @foreach (var rootItem in menuItems.Where(x => x.ParentID == null).OrderBy(x => x.SiraNo))
        {
            @RenderMenuItem(rootItem)
        } *@

        @foreach (var parent in menuItems.Where(x => x.ParentID == null).OrderBy(x => x.SiraNo))
        {
            <MudNavGroup Title="@parent.Tanimi" Icon="@GetIcon(parent)">
                @foreach (var child in menuItems.Where(x => x.ParentID == parent.ID).OrderBy(x => x.SiraNo))
                {
                    <MudNavLink Href="@child.Secenek" Match="NavLinkMatch.Prefix">@child.Tanimi</MudNavLink>
                }
            </MudNavGroup>
        }
    }
</MudNavMenu>


@code {
    [Inject]
    HttpClient client { get; set; }
    [Inject]
    ILocalStorageService LocalStorageService { get; set; }

    private List<MenuItemDto> menuItems = null;
    private string kullaniciKodu;

    private List<int> readyMenuIds = new List<int> { 9, 14, 15, 4, 5, 1, 8 };

    protected override async Task OnInitializedAsync()
    {
        kullaniciKodu = await LocalStorageService.GetItemAsync<string>(Consts.KullaniciKodu);

        menuItems = await client.GetServiceResponseAsync<List<MenuItemDto>>(UrlHelper.GetMenuList + "?kullanicikodu=" + kullaniciKodu);

        // Tüm menüler blazora aktarılmadığı için sadece aktarılanları aldık. Hepsi aktarılınca kaldıracağız.
        menuItems = menuItems.Where(i => readyMenuIds.Contains(i.ID)).ToList();
    }

    private static readonly Dictionary<string, string> IconMap = new()
    {
        { "CoPresent", Icons.Material.Outlined.CoPresent },
        { "List", Icons.Material.Outlined.List },
        { "FileUpload", Icons.Material.Outlined.FileUpload },
        { "AccountBalance", Icons.Material.Outlined.AccountBalance },
        { "Settings", Icons.Material.Outlined.Settings },
        { "SettingsApplications", Icons.Material.Outlined.SettingsApplications },
        { "ListAlt", Icons.Material.Outlined.ListAlt },
        { "Analytics", Icons.Material.Outlined.Analytics },
        { "CreditCard", Icons.Material.Outlined.CreditCard }
    };

    private string GetIcon(MenuItemDto item)
    {
        if (string.IsNullOrEmpty(item.imageName))
            return Icons.Material.Filled.Menu;

        return IconMap.TryGetValue(item.imageName, out var icon)
            ? icon
            : Icons.Material.Filled.Menu;
    }

