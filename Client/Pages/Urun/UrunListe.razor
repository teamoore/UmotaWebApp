    private List<UrunDto> filteredDataList = new();

    private void ApplyFilter()
    {
        filteredDataList = mainDataList
            .Where(u => (u.Aktif == 0) &&
                (SelectedCategories.Count == 0 || SelectedCategories.Contains(u.GrupKodu)) &&
                (SelectedNames.Count == 0 || SelectedNames.Contains(u.Adi)) &&
                (string.IsNullOrWhiteSpace(SearchText) ||
                 u.Kodu.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                 u.Adi.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                 u.Baslik.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                 u.Ozellik.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            )
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        header.HeaderText = "Ürün Listesi";

        kullaniciKodu = await LocalStorageService.GetItemAsync<string>(Consts.KullaniciKodu);
        kullaniciDto = await httpClient.GetServiceResponseAsync<SisKullaniciDto>(UrlHelper.KullaniciGetByKod + "?kod=" + kullaniciKodu);

        if (kullaniciDto.isAdmin)
        {
            fiyatGormeYetkisi = true;
            hesaplananAdetGormeYetkisi = true;
        }
        else
        {
            var yetki = await httpClient.GetServiceResponseAsync<int>(UrlHelper.GetKullaniciYetkisi + "?kullanicikodu=" + kullaniciKodu + "&yetkikodu=" + KullaniciYetkiKodlari.FiyatGormeYetkisi);
            if (yetki == 1)
                fiyatGormeYetkisi = true;

            var yetki2 = await httpClient.GetServiceResponseAsync<int>(UrlHelper.GetKullaniciYetkisi + "?kullanicikodu=" + kullaniciKodu + "&yetkikodu=" + KullaniciYetkiKodlari.HesaplananAdetGormeYetkisi);
            if (yetki2 == 1)
                hesaplananAdetGormeYetkisi = true;
        }

        await LoadList();
        allCategories = mainDataList.Select(u => u.GrupKodu).Distinct().ToList();
        allNames = mainDataList.Select(u => u.Adi).Distinct().ToList();
    }

