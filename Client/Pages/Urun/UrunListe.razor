    private void OnSelectedCategoriesChanged(IEnumerable<string> values)
    {
        SelectedCategories = values.ToList();
        ApplyFilter();
    }

    private void OnSelectedNamesChanged(IEnumerable<string> values)
    {
        SelectedNames = values.ToList();
        ApplyFilter();
    }

    async Task UrunDetayaGit(int urunref)
    {
        modalParameters = new ModalParameters();
        modalParameters.Add("UrunId", urunref);
        modalParameters.Add("isModalForm", 1);
        modal.Show<Urun.UrunDetay>("Ürün Detayı", modalParameters);

