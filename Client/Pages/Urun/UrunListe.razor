@page "/urunliste"


@* <HeaderSearchBar header="header"
                 ShowButtons="false" ShowFilterButton="false"
                 onDoneButtonClicked="BtnAraClick" onFilterButtonClicked="BtnDetayliAraClick" ShowSearchSection="true"></HeaderSearchBar>
 *@
@if (loadingCompleted == false)
{
    <MudProgressLinear Color="Color.Primary" Striped="true" Size="Size.Large" Indeterminate="true" Class="my-7" />
}



<MudPaper Class="pa-4" Style="display:flex; flex-direction:column; height:calc(100vh - 90px); overflow:hidden;">

    <MudGrid AlignItems="Center" GutterSize="2" Class="flex:0 0 auto; mb-2">
        <!-- Görünüm Seçici -->
        <MudItem xs="12" sm="2" Style="display:flex; align-items:center; gap:4px;">
            <MudIconButton Icon="@Icons.Material.Filled.TableRows"
                           Color="@(isTableView ? Color.Primary : Color.Default)"
                           OnClick="@(()=>isTableView=true)" />
            <MudIconButton Icon="@Icons.Material.Filled.GridView"
                           Color="@(isTableView ? Color.Default : Color.Primary)"
                           OnClick="@(()=>isTableView=false)" />
        </MudItem>

        <!-- Kategori Seçimi -->
        <MudItem xs="12" sm="3" Style="min-width:200px;">
            <MudSelect T="string" Label="Kategori" MultiSelection="true"
                       SelectedValues="SelectedCategories"
                       SelectedValuesChanged="OnSelectedCategoriesChanged"
                       FullWidth="true">
                @foreach (var kategori in allCategories)
                {
                    <MudSelectItem Value="@kategori">@kategori</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <!-- Ad Seçimi -->
        <MudItem xs="12" sm="3" Style="min-width:200px;">
            <MudSelect T="string" Label="Adı" MultiSelection="true"
                       SelectedValues="SelectedNames"
                       SelectedValuesChanged="OnSelectedNamesChanged"
                       FullWidth="true">
                @foreach (var adi in allNames)
                {
                    <MudSelectItem Value="@adi">@adi</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <!-- Arama -->
        <MudItem xs="12" sm="3" Style="min-width:250px;">
            <MudTextField @bind-Value="SearchText" Placeholder="Aranacak..." Label="Genel Arama"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" FullWidth="true" />
        </MudItem>

    </MudGrid>

    <div style="flex:1; overflow-y:auto;">

        @if (isTableView)
        {
            <!-- TABLO GÖRÜNÜMÜ -->

            <RadzenDataGrid Data="@filteredDataList" TItem="UrunDto" @ref="grid" AllowAlternatingRows="false" Style="height:calc(100vh - 150px); width:100%;"
                            AllowFiltering="true" AllowSorting="true" AllowColumnResize="true" AllowColumnReorder="true"
                            FilterMode="FilterMode.CheckBoxList"
                            AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" PageSizeOptions="@pageSizeOptions"
                            PageSize="100"
                            ColumnWidth="120px"
                            LogicalFilterOperator="LogicalFilterOperator.Or"
                            SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems
                            AllowColumnPicking="true" GridLines="DataGridGridLines.Both"
                            @bind-Settings="@Settings">
                <PagingSummaryTemplate>
                    <RadzenIcon Icon="database" Style="color: var(--rz-primary); font-size: var(--rz-pager-summary-font-size);" />
                    Displaying page @context.CurrentPage of @context.NumberOfPages <b>(total @context.TotalCount records)</b>
                </PagingSummaryTemplate>

                <Columns>
                    <RadzenDataGridColumn Property="@nameof(UrunDto.Kodu)" Title="Kodu" Width="80px" />
                    <RadzenDataGridColumn Width="80px" Title="" Filterable="false" Sortable="false" ColumnPickerTitle="İşlemler" Pickable="false" Reorderable="false">
                        <Template Context="data">
                            <RadzenButton ButtonStyle="ButtonStyle.Success" Variant="Radzen.Variant.Flat" Shade="Shade.Lighter" Icon="add_shopping_cart" class="rz-m-1" Click=@(() => SepeteEkle(data.ID)) />
                            <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Radzen.Variant.Flat" Shade="Shade.Lighter" Icon="info" class="rz-m-1" Click=@(() => UrunDetayaGit(data.ID)) />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="" ColumnPickerTitle="Fotoğraf" Sortable="false" Filterable="false" Width="100px" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <RadzenImage Path="@data.imagePath" Style="width:100px; height:100px; object-fit:contain; border-radius:6px;" AlternateText="@(data.Kodu + " " + data.Adi)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(UrunDto.Sezon)" Title="Sezon" Width="120px" />
                    <RadzenDataGridColumn Property="@nameof(UrunDto.GrupKodu)" Title="Kategori" Width="120px" />
                    <RadzenDataGridColumn Property="@nameof(UrunDto.Adi)" Title="Adı" Width="160px" />
                    <RadzenDataGridColumn Title="Başlık" Width="200px" Filterable="false">
                        <Template Context="data">
                            <div style="white-space: normal; word-break: break-word;">
                                @data.Baslik
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(UrunDto.Ozellik)" Title="Özellik" Width="300px" Filterable="false" Sortable="true">
                        <Template Context="data">
                            <div style="max-height: 100px; overflow-y: auto; white-space: normal; word-break: break-word;">
                                @data.Ozellik
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    @if (fiyatGormeYetkisi)
                    {
                        <RadzenDataGridColumn Property="@nameof(UrunDto.Fiyat2)" Title="Fiyat" TextAlign="TextAlign.Right">
                            <Template Context="order">
                                <div style="display: flex; flex-direction: column; align-items: flex-end;">
                                    <span>@String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", order.Fiyat2)</span>
                                    <span>@String.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:C}", order.Fiyat3)</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    @if (hesaplananAdetGormeYetkisi)
                    {
                        <RadzenDataGridColumn Property="@nameof(UrunDto.HesaplananAdet)" Title="Hesaplanan Adet" TextAlign="TextAlign.Right" FormatString="{0:N0}"> </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn Property="@nameof(UrunDto.ID)" Filterable="false" Title="ID" Width="80px" TextAlign="TextAlign.Center" Visible="false" />

                </Columns>
            </RadzenDataGrid>

        }
        else
        {
            <!-- KART GÖRÜNÜMÜ -->
            <MudGrid Justify="Justify.Center" Spacing="2" Class="pa-2">
                @foreach (var urun in filteredDataList)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Class="ma-2" Style="width:100%; height:100%; display:flex; flex-direction:column; justify-content:space-between;">
                            <img src="@urun.imagePath"
                                 alt="@urun.Adi"
                                 style="width:100%; height:200px; object-fit:contain; border-radius:6px;" />

                            <MudCardContent Style="padding:8px 12px 0 12px;">
                                <MudText Typo="Typo.subtitle1" Bold="true">@urun.Baslik</MudText>

                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@urun.Kodu</MudText>

                                    @if (hesaplananAdetGormeYetkisi)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                            Hesaplanan Adet : @String.Format("{0:N0}", urun.HesaplananAdet)
                                        </MudText>
                                    }
                                </div>

                                @if (fiyatGormeYetkisi)
                                {
                                    <div style="display:flex; flex-direction:column; align-items:flex-end; margin-top:4px;">
                                        <MudText Typo="Typo.h6" Color="Color.Primary">
                                            @String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", urun.Fiyat2)
                                        </MudText>
                                        <MudText Typo="Typo.h6" Color="Color.Secondary">
                                            @String.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:C}", urun.Fiyat3)
                                        </MudText>
                                    </div>
                                }
                            </MudCardContent>

                            <MudCardActions Style="padding:8px 12px 8px 12px; justify-content:space-between;">
                                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="(() => SepeteEkle(urun.ID))">
                                    Sepete Ekle
                                </MudButton>
                                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" OnClick="(() => UrunDetayaGit(urun.ID))">
                                    Ürün Detay
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

        }

    </div>
</MudPaper>


