    public void UrunDetayaGit(int urunref)
    {
        //navigation.NavigateTo("/urundetay/" + urunref);

        var opt = new ModalOptions();
        opt.ContentScrollable = true;

        var parameters = new ModalParameters();
        parameters.Add("UrunId", urunref);

        var form = modal.Show<Pages.Urun.UrunDetay>("Ürün Detay", parameters: parameters, options: opt);
    }

    public void SepeteEkle(int urunref)
