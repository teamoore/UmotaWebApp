
<EditForm Model="cariModel" OnValidSubmit="ValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (loadingCompleted == false)
    {
        <MudProgressLinear Color="Color.Primary" Striped="true" Size="Size.Large" Indeterminate="true" Class="my-7" />
    }

    <div class="mt-5">

        <div class="form">

            <div class="form-group">
                <div class="row">
                    <div class="col-md-10">
                        <label>Kodu</label>
                        <InputText @bind-Value="cariModel.Sevkkodu" class="form-control" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-10">
                        <label>Ünvan</label>
                        <InputText @bind-Value="cariModel.SevkEdilecekBayiAdi" class="form-control" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-10">
                        <label>Adres Satırı 1</label>
                        <InputText @bind-Value="cariModel.Sevkadres1" class="form-control" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-10">
                        <label>Adres Satırı 2</label>
                        <InputText @bind-Value="cariModel.Sevkadres2" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label>İlçe</label>
                        <InputText @bind-Value="cariModel.Ilce" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label>Şehir</label>
                        <InputText @bind-Value="cariModel.Il" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label>Ülke</label>
                        <InputText @bind-Value="cariModel.Ulke" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label>Posta Kodu</label>
                        <InputText @bind-Value="cariModel.Postakodu" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label>Telefon 1</label>
                        <InputText @bind-Value="cariModel.Tel1" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label>Telefon 2</label>
                        <InputText @bind-Value="cariModel.Tel2" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-10">
                        <label>E-Posta</label>
                        <InputText @bind-Value="cariModel.Mail" class="form-control" type="email" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-10">
                        <label>İlgili</label>
                        <InputText @bind-Value="cariModel.SevkIlgilisi" class="form-control"/>
                    </div>
                </div>
            </div>

        </div>
    </div>



    <div class="form-group">
        <MudButton Disabled="@_processing" OnClick="ValidSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Kaydediliyor...</MudText>
            }
            else
            {
                <MudText>Kaydet</MudText>
            }
        </MudButton>
        <CancelButtonComponent Caption="Vazgeç" OnClick="goBackCariList" />
    </div>

</EditForm>



@code
{
    [Parameter]
    public int? logref { get; set; }
    [Parameter]
    public int? CariKartRef { get; set; }
    [Parameter]
    public int? modalForm { get; set; }

    [CascadingParameter] IModalService modal { get; set; }
    [CascadingParameter] BlazoredModalInstance ModalInstance { get; set; }

    [Inject]
    ISnackbar Snackbar { get; set; }

    [Inject]
    ModalManager ModalManager { get; set; }

    [Inject]
    NavigationManager navigation { get; set; }

    [Inject]
    HttpClient httpClient { get; set; }

    [Inject]
    ILocalStorageService LocalStorageService { get; set; }

    [Inject]
    YetkiHelper yetkiHelper { get; set; }

    SevkAdresDto cariModel = new SevkAdresDto() { Ulke = "TÜRKİYE" };

    private bool isUpdate = false;
    private bool loadingCompleted = false;
    private bool _processing = false;

    public async Task KartGetir()
    {
        try
        {
            if (!logref.HasValue)
                return;

            var selectedFirmaDonem = await LocalStorageService.GetItemAsync<SisFirmaDonemDto>(Consts.FirmaDonem);

            if (selectedFirmaDonem == null)
                throw new Exception("Firma Dönem Seçili değil");

            cariModel = await httpClient.GetServiceResponseAsync<SevkAdresDto>(UrlHelper.CariKartGetirLogRef + "?logref=" + logref + "&firmaId=" + selectedFirmaDonem.firma_no.Value);

        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, severity: Severity.Error);
        }
    }

    public async Task Kaydet()
    {
        try
        {
            SubmitValidation();
        }
        catch (ClientException ex)
        {
            foreach (var item in ex.ErrorList)
            {
                Snackbar.Add(item, severity: Severity.Warning);
            }
            return;
        }
        catch (Exception)
        {
        }

        try
        {
            var selectedFirmaDonem = await LocalStorageService.GetItemAsync<SisFirmaDonemDto>(Consts.FirmaDonem);

            if (selectedFirmaDonem == null)
                throw new Exception("Firma Dönem Seçili değil");

            _processing = true;
            if (!isUpdate)
            {
                if (CariKartRef < 0) // adres bizim tabloya açılacaksa logref biz veriyoruz değilse logodan refini dönüyoruz
                {
                    var reff = await httpClient.GetServiceResponseAsync<int>(UrlHelper.RefNoAl + "?tablename=sevkadres&firmaId=" + selectedFirmaDonem.firma_no.Value);
                    cariModel.Logref = reff * -1; // Logo adres reflerle çakışmasın diye
                }

                cariModel.Clientref = CariKartRef;
                cariModel.Insuser = await LocalStorageService.GetItemAsync<string>(Consts.KullaniciKodu);
                cariModel.Insdate = DateTime.Now;
                cariModel.Active = 0;
                cariModel.Status = 0;
            }
            else
            {
                cariModel.Upduser = await LocalStorageService.GetItemAsync<string>(Consts.KullaniciKodu);
                cariModel.Upddate = DateTime.Now;
            }

            var request = new SevkAdresRequestDto();
            request.SevkAdres = cariModel;
            request.FirmaId = selectedFirmaDonem.firma_no.Value;
            request.LogoFirmaNo = selectedFirmaDonem.logo_firma.Value;

            if (isUpdate)
            {
                // cariModel = await httpClient.PostGetServiceResponseAsync<SevkAdresDto, SevkAdresRequestDto>(UrlHelper.CariKartAdresGuncelle, request);
                // Snackbar.Add("Sevk adresi güncellendi", severity: Severity.Success);
            }
            else
            {
                cariModel = await httpClient.PostGetServiceResponseAsync<SevkAdresDto, SevkAdresRequestDto>(UrlHelper.CariKartAdresKaydet, request);
                Snackbar.Add("Sevk adresi eklendi", severity: Severity.Success);
            }

            if (modalForm.HasValue)
                await ModalInstance.CloseAsync(ModalResult.Ok<SevkAdresDto>(cariModel));
            else
                await goBackCariList();
        }
        catch (Exception ex)
        {
            await ModalManager.ShowMessageAsync("Hata", ex.Message);
        }
        finally
        {
            _processing = false;
        }
    }

    public async Task ValidSubmit()
    {
        await Kaydet();
    }

    public async Task goBackCariList()
    {
        if (modalForm.HasValue)
            await ModalInstance.CloseAsync();
        else
            navigation.NavigateTo("/cari_kartf");
    }

    protected override Task OnParametersSetAsync()
    {
        if (logref.HasValue)
            isUpdate = true;

        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        if (logref.HasValue)
            isUpdate = true;

        if (isUpdate)
        {
            await KartGetir();
            return;
        } else
        {
            await SevkAdresKoduAl();
        }
        loadingCompleted = true;
    }

    public void SubmitValidation()
    {
        var err = new List<string>();

        if (string.IsNullOrWhiteSpace(cariModel.Sevkkodu))
            err.Add("Adres Kodu boş geçilemez");

        if (string.IsNullOrWhiteSpace(cariModel.SevkEdilecekBayiAdi))
            err.Add("Ünvan boş geçilemez");

        if (string.IsNullOrWhiteSpace(cariModel.Ulke))
            err.Add("Ülke boş geçilemez");

        if (string.IsNullOrWhiteSpace(cariModel.Il))
            err.Add("Şehir boş geçilemez");

        if (string.IsNullOrWhiteSpace(cariModel.Ilce))
            err.Add("İlçe boş geçilemez");

        if (string.IsNullOrWhiteSpace(cariModel.Postakodu))
            err.Add("Posta Kodu boş geçilemez");

        if (err.Count > 0)
        {
            var ex = new ClientException("Boş geçilemez alanlar");
            ex.ErrorList = err;

            throw ex;
        }
    }

    public async Task SevkAdresKoduAl()
    {
        cariModel.Sevkkodu = await yetkiHelper.CariSevkAdresKoduAl(CariKartRef.Value);
    }

}
